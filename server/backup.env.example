# Install as /etc/minecraft/backup.env, owned by root, mode 0600.
# Create a private B2 bucket and an application key limited to that bucket.
# restic needs list/read/write/delete files plus bucket metadata access.
# Do not enable a bucket lifecycle rule that deletes restic objects independently.
RESTIC_REPOSITORY=b2:YOUR_BUCKET:grxm-smp
B2_ACCOUNT_ID=YOUR_APPLICATION_KEY_ID
B2_ACCOUNT_KEY=YOUR_APPLICATION_KEY
RESTIC_PASSWORD_FILE=/etc/minecraft/restic-password
